# VK Platform — Docker settings. Copy to .env.docker (never commit it) and fill in.
# This one file replaces vk_digital_hub/.env, vk_platform/.env and vk_agent/.env on the server.

# --- Web app ---
VK_PLATFORM_PASSWORD=change-me
# Long random string; changing it signs everyone out.
VK_PLATFORM_SECRET=change-me-to-a-long-random-string
VK_PLATFORM_OPERATOR=Krupasagar
VK_PLATFORM_PUBLIC_URL=https://vkdigital.tipturbroadband.in
TZ=Asia/Kolkata

# --- Provider automation ---
# simulate = never touch portals (use for a first test run), live = real renewals
VK_PLATFORM_UPSTREAM_MODE=simulate
VK_PLATFORM_WORKER_ENABLED=1
VK_PLATFORM_JOB_POLL_SECONDS=5
VK_PLATFORM_JOB_RETRY_MINUTES=10
VK_PLATFORM_RAILTEL_ACCOUNT=
VK_PLATFORM_HATHWAY_ACCOUNT=

RAILWIRE_USER=
RAILWIRE_PASS=
# Multi-operator file: put it in ./secrets/ next to docker-compose.yml
RAILWIRE_ACCOUNTS_FILE=/secrets/railwire_accounts.json
RAILWIRE_DEFAULT_ACCOUNT_ID=
RAILTEL_DISCONNECT_REASON=
HATHWAY_USER=
HATHWAY_PASS=
# HATHWAY_ACCOUNTS_FILE=/secrets/hathway_operator_accounts.json
MOBIZE_LOGIN_URL=
MOBIZE_USER=
MOBIZE_PASS=
SMARTPLAY_USER=
SMARTPLAY_PASS=
SMARTPLAY_URL=https://portal.smartplaytv.in
ANT_IPTV_PHONE=

# --- Bix ---
BIX_SERVICE_TYPE=5
BIX_MOBILE=
BIX_PASSWORD=

# --- WhatsApp Web automation (scan the QR at Settings → WhatsApp screen) ---
WHATSAPP_WEB_AUTO_SEND=1
WHATSAPP_WEB_REUSE_BROWSER=1
RAILTEL_INVOICE_WHATSAPP_TEST=
RAILTEL_INVOICE_WHATSAPP_AFTER_DOWNLOAD=0

# --- Customer pay / billing ---
VK_PLATFORM_PUBLIC_PAY=1
VK_PLATFORM_UPI_VPA=
VK_PLATFORM_UPI_PAYEE=
VK_PLATFORM_GST_PERCENTAGE=0
VK_PLATFORM_DUE_DAYS=7
VK_PLATFORM_EXPIRING_SOON_DAYS=7

# --- Optional Cloudflare Tunnel (docker compose --profile tunnel up -d) ---
TUNNEL_TOKEN=
