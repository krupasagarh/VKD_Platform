# One Hathway cable operator (LCO). Copy to <lco>.env next to docker-compose.yml,
# fill it in, and never commit it. Each LCO gets its own file, data volume and port.

# --- Web app ---
# Owner login is "admin" with this password. Change it before handing over.
VK_PLATFORM_PASSWORD=change-me
# Long random string, different for every LCO; changing it signs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VK_PLATFORM_SECRET=change-me-to-a-long-random-string
VK_PLATFORM_OPERATOR=Operator name
# Address customers open from WhatsApp links and the pay QR, e.g. https://lco1.example.in
VK_PLATFORM_PUBLIC_URL=
TZ=Asia/Kolkata

# Only Hathway. The image already defaults to this; keep it so a wrong image tag cannot
# switch Railtel / ANT / SmartPlay back on.
VK_PLATFORM_PROVIDERS=hathway

# --- Hathway portal ---
# simulate = never touch the portal (first run, training); live = real renewals.
VK_PLATFORM_UPSTREAM_MODE=simulate
VK_PLATFORM_WORKER_ENABLED=1
VK_PLATFORM_JOB_POLL_SECONDS=5
VK_PLATFORM_JOB_RETRY_MINUTES=10
HATHWAY_USER=
HATHWAY_PASS=
# Several dealer logins for one LCO: put the JSON in ./secrets/ and point at it.
# HATHWAY_ACCOUNTS_FILE=/secrets/<lco>_hathway_accounts.json
VK_PLATFORM_HATHWAY_ACCOUNT=

# --- WhatsApp ---
# 1 = send from a WhatsApp Web login inside the container (scan the QR at
# Settings -> WhatsApp screen). 0 = staff send with one tap from their own phone.
WHATSAPP_WEB_AUTO_SEND=0
WHATSAPP_WEB_REUSE_BROWSER=1

# --- Customer pay / billing ---
VK_PLATFORM_PUBLIC_PAY=1
VK_PLATFORM_UPI_VPA=
VK_PLATFORM_UPI_PAYEE=
VK_PLATFORM_GST_PERCENTAGE=0
VK_PLATFORM_DUE_DAYS=7
VK_PLATFORM_EXPIRING_SOON_DAYS=7
