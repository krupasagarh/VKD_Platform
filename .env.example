# VK Platform configuration. Copy to .env and edit.

# --- Web app ---
VK_PLATFORM_HOST=127.0.0.1
VK_PLATFORM_PORT=8800
# Password for the owner login (username: admin). Change this.
VK_PLATFORM_PASSWORD=vkdigital
# Random string used to sign the login cookie.
VK_PLATFORM_SECRET=change-me-to-a-long-random-string
VK_PLATFORM_OPERATOR=Krupasagar

# --- Database ---
# Defaults to vk_platform/data/vk_platform.db
# VK_PLATFORM_DB=
# Bix Balance History extract (vk_digital_history.db). Import from Settings → Bix history.
# VK_BIX_HISTORY_DB=

# --- Upstream provider automation ---
# simulate = never touch provider portals (safe for testing)
# live     = drive Railtel/Hathway portals via railtel_debugger/vk_agent
VK_PLATFORM_UPSTREAM_MODE=simulate
# Run the background worker that executes queued provider jobs.
VK_PLATFORM_WORKER_ENABLED=1
VK_PLATFORM_JOB_POLL_SECONDS=5
VK_PLATFORM_JOB_RETRY_MINUTES=10
# Provider account ids from RAILWIRE_ACCOUNTS_FILE / HATHWAY_ACCOUNTS_FILE (blank = default account)
VK_PLATFORM_RAILTEL_ACCOUNT=
VK_PLATFORM_HATHWAY_ACCOUNT=
# Optional ANT CRM account label
VK_PLATFORM_IPTV_ACCOUNT=
# WhatsApp number ANT sends the partner/LCO OTP to (10 digits, no +91 in git)
# ANT_IPTV_PHONE=
# VK_PLATFORM_IPTV_PHONE=

# SmartPlay OTT partner login lives in the workspace .env (never commit the password):
# SMARTPLAY_USER=
# SMARTPLAY_PASS=
# SMARTPLAY_URL=https://portal.smartplaytv.in

# Public URL customers open from WhatsApp (LAN IP or domain). Example: http://192.168.1.11:8800
# VK_PLATFORM_PUBLIC_URL=
# While testing Railtel bill WhatsApp, send to this number instead of the customer's phone.
RAILTEL_INVOICE_WHATSAPP_TEST=7259316656
# Auto-send PDF on WhatsApp right after portal bill download (0 = save PDF only, send manually).
RAILTEL_INVOICE_WHATSAPP_AFTER_DOWNLOAD=0
# Enable WhatsApp Web automation for manual Send button on customer page.
WHATSAPP_WEB_AUTO_SEND=1
# Keep one Chrome tab open between sends (default 1). Set 0 to launch fresh each time.
WHATSAPP_WEB_REUSE_BROWSER=1
# Optional: reuse YOUR Chrome instead of a separate Playwright window.
# Start Chrome once: chrome.exe --remote-debugging-port=9222 --user-data-dir=%LOCALAPPDATA%\vk-wa-chrome
# Open web.whatsapp.com in that Chrome, scan QR, then set:
# WHATSAPP_WEB_CDP_URL=http://127.0.0.1:9222

# --- Billing defaults ---
VK_PLATFORM_GST_PERCENTAGE=0
VK_PLATFORM_DUE_DAYS=7
VK_PLATFORM_EXPIRING_SOON_DAYS=7

# Provider credentials themselves live in vk_digital_hub/.env and are read by
# railtel_debugger/vk_agent (RAILWIRE_USER, RAILWIRE_PASS, HATHWAY_USER, HATHWAY_PASS, ...)
